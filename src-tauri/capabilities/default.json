{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "updater:default",
    "process:default",
    "opener:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPLOCALDATA/**" }]
    },
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "claude",         "cmd": "claude",         "args": true, "sidecar": false },
        { "name": "gemini",         "cmd": "gemini",         "args": true, "sidecar": false },
        { "name": "gemini.cmd",     "cmd": "gemini.cmd",     "args": true, "sidecar": false },
        { "name": "codex",          "cmd": "codex",          "args": true, "sidecar": false },
        { "name": "codex.cmd",      "cmd": "codex.cmd",      "args": true, "sidecar": false },
        { "name": "powershell",     "cmd": "powershell",     "args": true, "sidecar": false },
        { "name": "powershell.exe", "cmd": "powershell.exe", "args": true, "sidecar": false },
        { "name": "cmd",            "cmd": "cmd",            "args": true, "sidecar": false },
        { "name": "cmd.exe",        "cmd": "cmd.exe",        "args": true, "sidecar": false }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "claude", "cmd": "claude", "args": true, "sidecar": false }
      ]
    }
  ]
}